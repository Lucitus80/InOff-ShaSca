<form class="shadow-scar roll-dialog">
  <p>
    <strong>{{actorName}}</strong> attacks with
    <strong>{{weaponName}}</strong> using <strong>{{skillLabel}}</strong> / <strong>{{attributeLabel}}</strong>.
  </p>

  <dl>
    <dt>Attribute value</dt>
    <dd>{{attributeValue}}</dd>

    <dt>Skill value</dt>
    <dd>{{skillValue}}</dd>

    <dt>Base dice pool</dt>
    <dd>{{basePool}}d6</dd>

    <dt>Damage</dt>
    <dd>{{weaponDamage}}</dd>

    {{#if range}}
      <dt>Range</dt>
      <dd>{{range}}</dd>
    {{/if}}

    <dt>Active Condition modifier</dt>
    <dd>{{conditionModifier}}</dd>
  </dl>

  {{#if activeConditions.length}}
    <section class="condition-summary">
      <h3>Active Conditions</h3>
      <ul>
        {{#each activeConditions as |condition|}}
          <li>
            <strong>{{condition.name}}</strong>: {{condition.modifier}}
            {{#if condition.penalty}} — {{condition.penalty}}{{/if}}
          </li>
        {{/each}}
      </ul>
    </section>
  {{/if}}

  <label class="field-block">
    <span>Bonus/Penalty</span>
    <input name="modifier" type="number" value="{{conditionModifier}}" step="1" autofocus />
  </label>

  <label class="field-block">
    <span>Difficulty</span>
    <input name="difficulty" type="number" value="1" min="0" step="1" />
  </label>

  <p class="hint">Current rule: Roll Attribute + Skill + bonus/penalty in d6. Defense/Resistance is handled after the roll.</p>
</form>
