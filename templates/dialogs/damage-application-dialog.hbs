<form class="shadow-scar damage-application-dialog">
  <p>Apply damage from <strong>{{weaponName}}</strong>.</p>

  <dl>
    <dt>Target(s)</dt>
    <dd>{{targetNames}}</dd>

    <dt>Configured damage</dt>
    <dd>{{damageText}}</dd>

    <dt>Numeric base damage</dt>
    <dd>{{baseDamage}}</dd>

    <dt>Attack margin</dt>
    <dd>{{margin}}</dd>
  </dl>

  <label class="field-block">
    <span>Final damage after Defense/Resistance</span>
    <input name="finalDamage" type="number" value="{{finalDamage}}" min="0" step="1" autofocus />
  </label>

  <p class="hint">Edit this value manually after applying the table's Defense/Resistance rules. This will reduce Vitality on the targeted or selected token actor(s).</p>
</form>
