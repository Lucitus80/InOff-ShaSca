<form class="shadow-scar roll-dialog">
  <p>
    <strong>{{actorName}}</strong> rolls
    <strong>{{attributeLabel}}</strong>.
  </p>

  <dl>
    <dt>Attribute value</dt>
    <dd>{{attributeValue}}</dd>

    <dt>Base dice pool</dt>
    <dd>{{attributeValue}}d6</dd>
  </dl>

  {{#if activeConditions.length}}
    <aside class="active-condition-summary">
      <strong>Active Conditions:</strong>
      {{#each activeConditions as |condition|}}
        <span>{{condition.name}}{{#if condition.modifier}} ({{condition.modifier}} dice){{/if}}{{#if condition.penalty}} — {{condition.penalty}}{{/if}}</span>
      {{/each}}
      <span><strong>Total:</strong> {{conditionModifier}}</span>
    </aside>
  {{/if}}

  <label class="field-block">
    <span>Bonus/Penalty</span>
    <input name="modifier" type="number" value="{{conditionModifier}}" step="1" autofocus />
  </label>

  <label class="field-block">
    <span>Difficulty</span>
    <input name="difficulty" type="number" value="1" min="0" step="1" />
  </label>

  <p class="hint">Current rule: Roll Attribute + bonus/penalty in d6. Active Condition modifiers are prefilled. 1–3 count as 0 successes, 4–5 as 1 success, 6 as 2 successes. Successes ≥ difficulty means success.</p>
</form>
