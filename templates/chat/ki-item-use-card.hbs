<div class="shadow-scar chat-card ki-item-card">
  <header class="card-header">
    <h3>{{itemName}}</h3>
    <p>{{actorName}} uses a {{itemTypeLabel}}.</p>
  </header>

  <div class="card-grid">
    {{#if clanLabel}}<div><strong>Clan:</strong> {{clanLabel}}</div>{{/if}}
    {{#if rankLabel}}<div><strong>Rank:</strong> {{rankLabel}}</div>{{/if}}

    {{#if hasCost}}
      <div><strong>Ki Cost:</strong> {{kiCost}}</div>
      {{#if spendKi}}
        <div><strong>Ki Reserve:</strong> {{currentKi}} → {{remainingKi}}</div>
      {{else}}
        <div><strong>Ki Reserve:</strong> not spent</div>
      {{/if}}
    {{/if}}
  </div>

  {{#if description}}
    <section class="card-effect">
      <strong>Text</strong>
      <div>{{{description}}}</div>
    </section>
  {{/if}}
</div>
