<div class="shadow-scar chat-card ki-item-card">
  <header class="card-header">
    <h3>{{itemName}}</h3>
    <p>{{actorName}} uses a {{itemTypeLabel}}.</p>
  </header>

  <div class="card-grid">
    {{#if rank}}<div><strong>Rank:</strong> {{rank}}</div>{{/if}}
    {{#if origin}}<div><strong>Origin:</strong> {{origin}}</div>{{/if}}
    {{#if usesKi}}
      <div><strong>Ki Cost:</strong> {{kiCost}}</div>
      {{#if spendKi}}
        <div><strong>Ki Reserve:</strong> {{currentKi}} → {{remainingKi}}</div>
      {{else}}
        <div><strong>Ki Reserve:</strong> not spent</div>
      {{/if}}
    {{/if}}
    {{#if timing}}<div><strong>Timing:</strong> {{timing}}</div>{{/if}}
    {{#if trigger}}<div><strong>Trigger:</strong> {{trigger}}</div>{{/if}}
    {{#if range}}<div><strong>Range:</strong> {{range}}</div>{{/if}}
    {{#if duration}}<div><strong>Duration:</strong> {{duration}}</div>{{/if}}
  </div>

  {{#if effect}}
    <section class="card-effect">
      <strong>Effect</strong>
      <p>{{effect}}</p>
    </section>
  {{/if}}

  {{#if tags}}
    <p class="card-tags"><strong>Tags:</strong> {{tags}}</p>
  {{/if}}
</div>
