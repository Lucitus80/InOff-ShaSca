<div class="shadow-scar chat-card gear-use-card">
  <header>
    <h2>{{itemName}}</h2>
    <p>{{actorName}} uses gear</p>
  </header>

  <dl>
    {{#if category}}
      <dt>Category</dt>
      <dd>{{category}}</dd>
    {{/if}}

    <dt>Quantity</dt>
    <dd>{{quantity}}</dd>

    <dt>Equipped</dt>
    <dd>{{#if equipped}}Yes{{else}}No{{/if}}</dd>

    {{#if tags}}
      <dt>Tags</dt>
      <dd>{{tags}}</dd>
    {{/if}}
  </dl>

  {{#if effect}}
    <section class="card-effect">
      <h3>Effect</h3>
      <p>{{effect}}</p>
    </section>
  {{/if}}
</div>
