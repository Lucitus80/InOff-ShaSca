<div class="shadow-scar chat-card skill-roll-card">
  <header>
    <h2>{{skillLabel}}</h2>
    <p>{{actorName}} · {{attributeLabel}}</p>
  </header>

  <dl>
    <dt>Attribute value</dt>
    <dd>{{attributeValue}}</dd>

    <dt>Skill value</dt>
    <dd>{{skillValue}}</dd>

    <dt>Bonus/Penalty</dt>
    <dd>{{modifier}}</dd>

    <dt>Dice pool</dt>
    <dd>{{pool}}d6</dd>

    <dt>Difficulty</dt>
    <dd>{{difficulty}}</dd>

    <dt>Successes</dt>
    <dd>{{successes}}</dd>

    <dt>Margin</dt>
    <dd>{{margin}}</dd>
  </dl>

  {{#if activeConditions.length}}
    <section class="condition-summary">
      <h3>Active Conditions</h3>
      <ul>
        {{#each activeConditions as |condition|}}
          <li><strong>{{condition.name}}</strong>: {{condition.modifier}}{{#if condition.penalty}} — {{condition.penalty}}{{/if}}</li>
        {{/each}}
      </ul>
    </section>
  {{/if}}

  <p class="dice-results">
    {{#each dice as |die|}}
      <span class="die-result">{{die}}</span>
    {{/each}}
  </p>

  <p class="roll-outcome {{#if success}}success{{else}}failure{{/if}}">
    {{resultLabel}}
  </p>
</div>
