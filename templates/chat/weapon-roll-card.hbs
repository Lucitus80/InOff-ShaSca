<div class="shadow-scar chat-card weapon-roll-card">
  <header>
    <h2>{{weaponName}}</h2>
    <p>{{actorName}} · {{skillLabel}} / {{attributeLabel}}</p>
  </header>

  <dl>
    <dt>Attribute value</dt>
    <dd>{{attributeValue}}</dd>

    <dt>Skill value</dt>
    <dd>{{skillValue}}</dd>

    <dt>Bonus/Penalty</dt>
    <dd>{{modifier}}</dd>

    <dt>Dice pool</dt>
    <dd>{{pool}}d6</dd>

    <dt>Difficulty</dt>
    <dd>{{difficulty}}</dd>

    <dt>Successes</dt>
    <dd>{{successes}}</dd>

    <dt>Margin</dt>
    <dd>{{margin}}</dd>

    <dt>Damage</dt>
    <dd><strong>{{weaponDamage}}</strong></dd>

    {{#if range}}
      <dt>Range</dt>
      <dd>{{range}}</dd>
    {{/if}}
  </dl>

  {{#if activeConditions.length}}
    <section class="condition-summary">
      <h3>Active Conditions</h3>
      <ul>
        {{#each activeConditions as |condition|}}
          <li><strong>{{condition.name}}</strong>: {{condition.modifier}}{{#if condition.penalty}} — {{condition.penalty}}{{/if}}</li>
        {{/each}}
      </ul>
    </section>
  {{/if}}

  <p class="dice-results">
    {{#each dice as |die|}}
      <span class="die-result">{{die}}</span>
    {{/each}}
  </p>

  <p class="roll-outcome {{#if success}}success{{else}}failure{{/if}}">
    {{resultLabel}}
  </p>

  <section class="damage-reminder">
    <p><strong>Damage:</strong> {{weaponDamage}}</p>
    <p class="hint">The Apply Damage dialog reads equipped armor/protection on the target, suggests final damage, and still lets you edit the result manually.</p>
    <button
      type="button"
      data-action="shadow-scar-apply-damage"
      data-base-damage="{{numericDamage}}"
      data-damage-text="{{weaponDamage}}"
      data-margin="{{margin}}"
      data-weapon-name="{{weaponName}}"
    >
      Apply Damage
    </button>
  </section>
</div>
