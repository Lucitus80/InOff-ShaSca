<form class="{{cssClass}} shadow-scar item-sheet" autocomplete="off">
  <header class="sheet-header item-header">
    <img class="profile-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" height="72" width="72" />

    <div class="header-fields">
      <h1>
        <input name="name" type="text" value="{{item.name}}" placeholder="Name" />
      </h1>
      <p class="item-type-label">{{itemTypeLabel}}</p>
    </div>
  </header>

  <section class="sheet-body item-sheet-body">
    {{#if (eq item.type "gear")}}
      <section class="panel item-fields-panel">
        <h2>Gear</h2>

        <div class="item-field-grid two-fields">
          <label class="field-block">
            <span>Category</span>
            <select name="system.category">
              <option value="">Custom / Unset</option>
              {{#each config.gearCategories as |label key|}}
                <option value="{{key}}" {{#if (eq ../system.category key)}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
          </label>

          <label class="field-block">
            <span>Quantity</span>
            <input name="system.quantity" type="number" value="{{system.quantity}}" min="0" step="1" />
          </label>
        </div>

        <label class="field-block inline-checkbox">
          <span>Equipped / Carried actively</span>
          <input name="system.equipped" type="checkbox" {{#if system.equipped}}checked{{/if}} />
        </label>

        <label class="field-block">
          <span>Use / Effect Summary</span>
          <input name="system.effect" type="text" value="{{system.effect}}" placeholder="What happens when this gear is used?" />
        </label>

        <label class="field-block">
          <span>Tags</span>
          <input name="system.tags" type="text" value="{{system.tags}}" placeholder="comma-separated tags" />
        </label>
      </section>
    {{/if}}

    {{#if (eq item.type "weapon")}}
      <section class="panel item-fields-panel">
        <h2>Weapon</h2>

        <div class="item-field-grid two-fields">
          <label class="field-block">
            <span>Attack Skill</span>
            <select name="system.skill">
              <option value="">None / Custom</option>
              {{#each config.flatSkills as |label key|}}
                <option value="{{key}}" {{#if (eq ../system.skill key)}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
          </label>

          <label class="field-block">
            <span>Category</span>
            <select name="system.category">
              <option value="">Custom / Unset</option>
              {{#each config.weaponCategories as |label key|}}
                <option value="{{key}}" {{#if (eq ../system.category key)}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
          </label>
        </div>

        <div class="item-field-grid two-fields">
          <label class="field-block">
            <span>Damage</span>
            <input name="system.damage" type="text" value="{{system.damage}}" />
          </label>

          <label class="field-block">
            <span>Range</span>
            <input name="system.range" type="text" value="{{system.range}}" />
          </label>
        </div>

        <label class="field-block inline-checkbox">
          <span>Equipped</span>
          <input name="system.equipped" type="checkbox" {{#if system.equipped}}checked{{/if}} />
        </label>

        <label class="field-block">
          <span>Tags</span>
          <input name="system.tags" type="text" value="{{system.tags}}" placeholder="comma-separated traits/tags" />
        </label>
      </section>
    {{/if}}

    {{#if (eq item.type "technique")}}
      <section class="panel item-fields-panel">
        <h2>Technique</h2>

        <div class="item-field-grid two-fields">
          <label class="field-block">
            <span>Rank</span>
            <input name="system.rank" type="text" value="{{system.rank}}" placeholder="Rank" />
          </label>

          <label class="field-block">
            <span>Origin</span>
            <input name="system.origin" type="text" value="{{system.origin}}" placeholder="Origin / school / tradition" />
          </label>
        </div>

        <div class="item-field-grid two-fields">
          <label class="field-block">
            <span>Attribute</span>
            <select name="system.attribute">
              {{#each config.attributes as |label key|}}
                <option value="{{key}}" {{#if (eq ../system.attribute key)}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
          </label>

          <label class="field-block">
            <span>Skill</span>
            <select name="system.skill">
              <option value="">None</option>
              {{#each config.flatSkills as |label key|}}
                <option value="{{key}}" {{#if (eq ../system.skill key)}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
          </label>
        </div>

        <div class="item-field-grid two-fields">
          <label class="field-block">
            <span>Timing</span>
            <select name="system.timing">
              <option value="">Custom / Unset</option>
              {{#each config.techniqueTiming as |label key|}}
                <option value="{{key}}" {{#if (eq ../system.timing key)}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
          </label>

          <label class="field-block">
            <span>Trigger</span>
            <input name="system.trigger" type="text" value="{{system.trigger}}" />
          </label>
        </div>

        <label class="field-block">
          <span>Effect Summary</span>
          <input name="system.effect" type="text" value="{{system.effect}}" />
        </label>

        <label class="field-block">
          <span>Tags</span>
          <input name="system.tags" type="text" value="{{system.tags}}" placeholder="comma-separated tags" />
        </label>
      </section>
    {{/if}}

    {{#if (eq item.type "mikkyo")}}
      <section class="panel item-fields-panel">
        <h2>Mikkyo</h2>

        <div class="item-field-grid three-fields">
          <label class="field-block">
            <span>Rank</span>
            <input name="system.rank" type="text" value="{{system.rank}}" placeholder="Rank" />
          </label>

          <label class="field-block">
            <span>Origin</span>
            <input name="system.origin" type="text" value="{{system.origin}}" placeholder="Origin / school / tradition" />
          </label>

          <label class="field-block">
            <span>Ki Cost</span>
            <input name="system.kiCost" type="number" value="{{system.kiCost}}" min="0" step="1" />
          </label>
        </div>

        <div class="item-field-grid three-fields">
          <label class="field-block">
            <span>Range</span>
            <input name="system.range" type="text" value="{{system.range}}" />
          </label>

          <label class="field-block">
            <span>Duration</span>
            <input name="system.duration" type="text" value="{{system.duration}}" />
          </label>

          <label class="field-block">
            <span>Timing</span>
            <select name="system.timing">
              <option value="">Custom / Unset</option>
              {{#each config.techniqueTiming as |label key|}}
                <option value="{{key}}" {{#if (eq ../system.timing key)}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
          </label>
        </div>

        <label class="field-block">
          <span>Effect Summary</span>
          <input name="system.effect" type="text" value="{{system.effect}}" />
        </label>

        <label class="field-block">
          <span>Tags</span>
          <input name="system.tags" type="text" value="{{system.tags}}" placeholder="comma-separated tags" />
        </label>
      </section>
    {{/if}}

    {{#if (eq item.type "condition")}}
      <section class="panel item-fields-panel">
        <h2>Condition</h2>

        <div class="item-field-grid four-fields">
          <label class="field-block inline-checkbox">
            <span>Active</span>
            <input name="system.active" type="checkbox" {{#if system.active}}checked{{/if}} />
          </label>

          <label class="field-block">
            <span>Intensity</span>
            <input name="system.intensity" type="number" value="{{system.intensity}}" min="0" step="1" />
          </label>

          <label class="field-block">
            <span>Roll Modifier</span>
            <input name="system.modifier" type="number" value="{{system.modifier}}" step="1" />
          </label>

          <label class="field-block">
            <span>Category</span>
            <select name="system.category">
              <option value="">Custom / Unset</option>
              {{#each config.conditionCategories as |label key|}}
                <option value="{{key}}" {{#if (eq ../system.category key)}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
          </label>
        </div>

        <label class="field-block">
          <span>Penalty / Mechanical Note</span>
          <input name="system.penalty" type="text" value="{{system.penalty}}" placeholder="Rules text / reminder, e.g. -1 die on physical actions" />
        </label>
      </section>
    {{/if}}

    <section class="panel">
      <h2>Description</h2>
      {{editor system.description target="system.description" button=true editable=editable engine="prosemirror"}}
    </section>
  </section>
</form>
