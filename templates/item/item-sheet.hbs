<form class="{{cssClass}} shadow-scar item-sheet" autocomplete="off">
  <header class="sheet-header item-header">
    <img class="profile-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" height="72" width="72" />

    <div class="header-fields">
      <h1>
        <input name="name" type="text" value="{{item.name}}" placeholder="Name" />
      </h1>
      <p class="item-type-label">{{itemTypeLabel}}</p>
    </div>
  </header>

  <section class="sheet-body item-sheet-body">
    {{#if (eq item.type "gear")}}
      <section class="panel item-fields-panel">
        <h2>Gear</h2>

        <div class="item-field-grid two-fields">
          <label class="field-block">
            <span>Category</span>
            <select name="system.category">
              <option value="">Custom / Unset</option>
              {{#each config.gearCategories as |label key|}}
                <option value="{{key}}" {{#if (eq ../system.category key)}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
          </label>

          <label class="field-block">
            <span>Quantity</span>
            <input name="system.quantity" type="number" value="{{system.quantity}}" min="0" step="1" />
          </label>
        </div>

        <label class="field-block inline-checkbox">
          <span>Equipped / Carried actively</span>
          <input name="system.equipped" type="checkbox" {{#if system.equipped}}checked{{/if}} />
        </label>

        <label class="field-block">
          <span>Effect Summary</span>
          <input name="system.effect" type="text" value="{{system.effect}}" />
        </label>

        <label class="field-block item-description-field">
          <span>Description</span>
          <textarea name="system.description" rows="6" placeholder="Describe this gear item, its use, limits and narrative details here.">{{{system.description}}}</textarea>
        </label>

        <div class="item-field-grid four-fields protection-fields">
          <label class="field-block">
            <span>Armor</span>
            <input name="system.armorValue" type="number" value="{{system.armorValue}}" min="0" step="1" />
          </label>

          <label class="field-block">
            <span>Resistance</span>
            <input name="system.resistanceValue" type="number" value="{{system.resistanceValue}}" min="0" step="1" />
          </label>

          <label class="field-block">
            <span>Defense Bonus</span>
            <input name="system.defenseBonus" type="number" value="{{system.defenseBonus}}" step="1" />
          </label>

          <label class="field-block">
            <span>Damage Reduction</span>
            <input name="system.damageReduction" type="number" value="{{system.damageReduction}}" min="0" step="1" />
          </label>
        </div>

        <label class="field-block">
          <span>Protection Notes</span>
          <input name="system.notes" type="text" value="{{system.notes}}" placeholder="armor traits, resistance notes, defense conditions" />
        </label>

        <label class="field-block">
          <span>Tags</span>
          <input name="system.tags" type="text" value="{{system.tags}}" placeholder="comma-separated tags" />
        </label>
      </section>
    {{/if}}

    {{#if (eq item.type "weapon")}}
      <section class="panel item-fields-panel">
        <h2>Weapon</h2>

        <div class="item-field-grid two-fields">
          <label class="field-block">
            <span>Attack Skill</span>
            <select name="system.skill">
              <option value="">None / Custom</option>
              {{#each config.flatSkills as |label key|}}
                <option value="{{key}}" {{#if (eq ../system.skill key)}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
          </label>

          <label class="field-block">
            <span>Category</span>
            <select name="system.category">
              <option value="">Custom / Unset</option>
              {{#each config.weaponCategories as |label key|}}
                <option value="{{key}}" {{#if (eq ../system.category key)}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
          </label>
        </div>

        <div class="item-field-grid two-fields">
          <label class="field-block">
            <span>Damage</span>
            <input name="system.damage" type="text" value="{{system.damage}}" />
          </label>

          <label class="field-block">
            <span>Range</span>
            <input name="system.range" type="text" value="{{system.range}}" />
          </label>
        </div>

        <label class="field-block inline-checkbox">
          <span>Equipped</span>
          <input name="system.equipped" type="checkbox" {{#if system.equipped}}checked{{/if}} />
        </label>

        <label class="field-block item-description-field">
          <span>Description</span>
          <textarea name="system.description" rows="6" placeholder="Describe this weapon, its handling, traits and special rules here.">{{{system.description}}}</textarea>
        </label>

        <label class="field-block">
          <span>Tags</span>
          <input name="system.tags" type="text" value="{{system.tags}}" placeholder="comma-separated traits/tags" />
        </label>
      </section>
    {{/if}}

    {{#if (eq item.type "technique")}}
      <section class="panel item-fields-panel">
        <h2>Technique</h2>
        <p class="hint">Techniques use Clan, Rank and editable rules text.</p>

        <div class="item-field-grid two-fields">
          <label class="field-block">
            <span>Clan</span>
            <select name="system.clan">
              {{#each config.clans as |label key|}}
                <option value="{{key}}" {{#if (eq ../clan key)}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
          </label>

          <label class="field-block">
            <span>Rank</span>
            <select name="system.rank">
              {{#each config.ranks as |label key|}}
                <option value="{{key}}" {{#if (eq ../rank key)}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
          </label>
        </div>

        <label class="field-block item-description-field">
          <span>Description</span>
          <textarea name="system.description" rows="10" placeholder="Describe the Technique rules, limitations and narrative effect here.">{{{system.description}}}</textarea>
        </label>
      </section>
    {{/if}}

    {{#if (eq item.type "mikkyo")}}
      <section class="panel item-fields-panel">
        <h2>Mikkyo</h2>
        <p class="hint">Mikkyo uses Clan, Rank, fixed Ki cost by Rank, and editable rules text.</p>

        <div class="item-field-grid three-fields">
          <label class="field-block">
            <span>Clan</span>
            <select name="system.clan">
              {{#each config.clans as |label key|}}
                <option value="{{key}}" {{#if (eq ../clan key)}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
          </label>

          <label class="field-block">
            <span>Rank</span>
            <select name="system.rank" data-action="mikkyo-rank-change">
              {{#each config.ranks as |label key|}}
                <option value="{{key}}" {{#if (eq ../rank key)}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
          </label>

          <label class="field-block">
            <span>Ki Cost</span>
            <input class="readonly-box" data-field="mikkyo-ki-cost" type="text" value="{{mikkyoKiCost}} Ki" readonly />
            <input name="system.kiCost" type="hidden" value="{{mikkyoKiCost}}" />
          </label>
        </div>

        <label class="field-block item-description-field">
          <span>Description</span>
          <textarea name="system.description" rows="10" placeholder="Describe the Mikkyo prayer, limitations, range, duration and effect here.">{{{system.description}}}</textarea>
        </label>
      </section>
    {{/if}}


    {{#if (eq item.type "quirk")}}
      <section class="panel item-fields-panel">
        <h2>Quirk</h2>
        <p class="hint">Quirks are split into Advantages and Disadvantages on the character sheet.</p>

        <label class="field-block">
          <span>Category</span>
          <select name="system.quirkType">
            {{#each config.quirkTypes as |label key|}}
              <option value="{{key}}" {{#if (eq ../system.quirkType key)}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </label>

        <label class="field-block item-description-field">
          <span>Description</span>
          <textarea name="system.description" rows="10" placeholder="Describe the quirk here.">{{{system.description}}}</textarea>
        </label>
      </section>
    {{/if}}

    {{#if (eq item.type "homelandAbility")}}
      <section class="panel item-fields-panel">
        <h2>Homeland Ability</h2>
        <p class="hint">This is the special ability granted by the character's homeland/origin.</p>

        <label class="field-block item-description-field">
          <span>Description</span>
          <textarea name="system.description" rows="10" placeholder="Describe the homeland special ability here.">{{{system.description}}}</textarea>
        </label>
      </section>
    {{/if}}

    {{#if (eq item.type "condition")}}
      <section class="panel item-fields-panel">
        <h2>Condition</h2>

        <div class="item-field-grid three-fields">
          <label class="field-block inline-checkbox">
            <span>Active</span>
            <input name="system.active" type="checkbox" {{#if system.active}}checked{{/if}} />
          </label>

          <label class="field-block">
            <span>Modifier</span>
            <input name="system.modifier" type="number" value="{{system.modifier}}" step="1" />
          </label>

          <label class="field-block">
            <span>Intensity</span>
            <input name="system.intensity" type="number" value="{{system.intensity}}" min="0" step="1" />
          </label>
        </div>

        <label class="field-block">
          <span>Category</span>
          <select name="system.category">
            <option value="">Custom / Unset</option>
            {{#each config.conditionCategories as |label key|}}
              <option value="{{key}}" {{#if (eq ../system.category key)}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </label>

        <label class="field-block">
          <span>Penalty / Mechanical Note</span>
          <input name="system.penalty" type="text" value="{{system.penalty}}" />
        </label>

        <label class="field-block item-description-field">
          <span>Description</span>
          <textarea name="system.description" rows="8" placeholder="Describe the condition, its rules and narrative effects here.">{{{system.description}}}</textarea>
        </label>
      </section>
    {{/if}}
  </section>
</form>
